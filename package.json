{
  "name": "labframe-manager",
  "description": "Independent Labframe host management control plane",
  "type": "module",
  "version": "0.1.0-alpha.5",
  "private": true,
  "files": [
    "dist",
    "resources",
    "web"
  ],
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "tsc -b && node build-ui.mjs",
    "check": "eslint src ui test && tsc --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "dev": "node build-ui.mjs && tsx watch src/main.ts",
    "format": "prettier --write .",
    "release": "pnpm build && node dist/release/main.js",
    "start": "node dist/main.js",
    "test": "pnpm test:unit",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:artifact": "tsx test/integration/artifact-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@therealkenc/telemetry": "git+https://github.com/therealkenc/telemetry.git#44da04b23873eb7fce7dd605c9b22ff91ebc69e5&path:/packages/core",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "secrets-api": "file:../secrets-api",
    "zod": "^4.6.7",
    "@therealkenc/app-runtime": "file:../app-runtime"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "@therealkenc/release-tools": "file:../release-tools",
    "@eslint/js": "^9.39.5"
  },
  "packageManager": "pnpm@11.21.0"
}
